# ==========================================
# FINOVARA Environment Configuration
# ==========================================

PORT=5000

# MongoDB URI (Optional: Better Auth & Enquiries auto-fallback to local persistent store if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/finovara

# Better Auth Configuration
BETTER_AUTH_SECRET=finovara-better-auth-secret-key-32chars-minimum-for-security
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth Credentials (Get these from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

