# ==========================================
# FINOVARA Environment Configuration
# Copy this file to .env before running:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ==========================================

# Server port (default: 5000)
PORT=5000

# MongoDB URI
# Option A – Local MongoDB (default, works out of the box)
MONGODB_URI=mongodb://127.0.0.1:27017/finovara
# Option B – MongoDB Atlas (replace with your connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/finovara

# Better Auth Configuration
BETTER_AUTH_SECRET=finovara-better-auth-secret-key-32chars-minimum-for-security
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth Credentials (Get from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI to add: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
